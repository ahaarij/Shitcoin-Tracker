# ---------------------------------------------------------------------------
# New Token Radar backend — environment variables. ALL ARE OPTIONAL.
# Locally: copy to .env and `export $(grep -v '^#' .env | xargs)` (or set them in Railway's Variables tab).
# ---------------------------------------------------------------------------

# Port to listen on. Railway sets this automatically — don't set it there.
PORT=8000

# Comma-separated list of browser origins allowed to call the API / open the WebSocket.
# Use your Vercel URL in production, e.g. https://new-token-radar.vercel.app  (no trailing slash)
# "*" allows everything (fine for local development).
ALLOWED_ORIGINS=*

# Optional regex for extra allowed origins, e.g. Vercel preview deployments:
# ALLOWED_ORIGIN_REGEX=https://new-token-radar-.*\.vercel\.app

# Which chains to run. "all" or a comma list of:
#   solana,ethereum,bnb,base,arbitrum,polygon,optimism,avalanche
ENABLED_CHAINS=all

# Optional: an Alchemy key switches every EVM chain to Alchemy endpoints (free tier is fine).
# ALCHEMY_API_KEY=

# Optional per-chain RPC overrides (these win over everything else). Pattern: <CHAIN>_WS_URL / <CHAIN>_HTTP_URL
# ETHEREUM_WS_URL=wss://ethereum-rpc.publicnode.com
# ETHEREUM_HTTP_URL=https://ethereum-rpc.publicnode.com
# BASE_WS_URL=
# BASE_HTTP_URL=

# Solana Pump.fun feeds. All are used at once and de-duplicated (more coverage if one is sparse).
# SOLANA_WS_URLS=wss://pumpportal.fun/api/data,wss://pumpdev.io/ws

# Live price / market cap from DexScreener's free API (no key). "false" turns it off.
# ENABLE_PRICES=true

# Runners page: tokens whose market cap rises at least RUNNER_MIN_GAIN_PCT (200 = 3x)
# within RUNNER_WINDOW_MINUTES of launch. They keep updating for RUNNER_TRACK_HOURS.
# RUNNER_MIN_GAIN_PCT=200
# RUNNER_WINDOW_MINUTES=30
# RUNNER_TRACK_HOURS=6
# RUNNER_MIN_LIQUIDITY_USD=1000   # ignore pumps in pools with less liquidity than this (EVM)
# MAX_RUNNERS=300
# Sniper rule: wallets that bought in the first seconds may hold at most this % of supply now.
# RUNNER_MAX_SNIPER_PCT=10
# SNIPER_SLOTS=10        # Solana: "first seconds" = this many slots after launch (~0.4 s each)
# SNIPER_SECONDS=4       # EVM: buys within ~this many seconds of the pool (at least 1 block)
# Solana RPCs for sniper checks (free public ones by default). A free Helius key raises the limits:
# SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOURKEY,https://solana-rpc.publicnode.com
# Save runners across restarts. On Railway: add a Volume mounted at /data, then:
# RUNNERS_FILE=/data/runners.json

# Tuning
# BUFFER_SIZE=1000          # tokens kept in memory
# SNAPSHOT_SIZE=100         # tokens sent to each browser on connect
# HEARTBEAT_SECONDS=20
# STATUS_PUSH_SECONDS=5
# EVM_STALE_SECONDS=900     # reconnect an EVM chain after this long with zero messages
# SOLANA_STALE_SECONDS=120
# LOG_LEVEL=INFO
